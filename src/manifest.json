{
  "manifest_version": 3,
  "name": "pocketmittens",
  "version": "0.1.0",
  "description": "Overlays a neural-net move hint on lichess.org and chess.com boards. For analysis, puzzles, unrated and bot games only.",
  "minimum_chrome_version": "116",
  "permissions": ["offscreen", "storage"],
  "icons": { "128": "mittens.png" },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "mittens.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*", "https://www.chess.com/*"],
      "js": ["content/content.js"],
      "css": ["styles/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
